---
import Base from "../layouts/Base.astro";
import { experience, tools } from "../data/about";
import { LINKS, SITE } from "../config";
---

<Base title="About">
  <section class="pro">
    <h1 class="title">About</h1>
    <div class="lead">
      <p>
        Information Technology (Honours) student @ <a class="u" href={LINKS.uts} target="_blank" rel="noopener">University of Technology Sydney</a>,
        with a double major in Data Analytics and Networking and Cybersecurity (6.33/7 GPA).
      </p>
      <p>
        I'm also an incoming Software Engineering Intern @ <a class="u" href={LINKS.pertamina} target="_blank" rel="noopener">Pertamina</a>,
        where I will be joining their Digital Analytics Solution team for 3 months.
      </p>
    </div>

    <h2>Experience</h2>
    <div>
      {
        experience.map((e) => (
          <div class="pro-row">
            <span class="when">{e.when}</span>
            <div>
              <b>{e.orgUrl ? <a class="u" href={e.orgUrl} target="_blank" rel="noopener">{e.org}</a> : e.org}</b> · {e.role}
              <p>{e.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <h2>Tools</h2>
    <div>
      {
        tools.map((t) => (
          <div class="pro-row">
            <span class="when">{t.group}</span>
            <div class="chips">
              {t.items.map((item) => <span class:list={{ learn: t.learning }}>{item}</span>)}
            </div>
          </div>
        ))
      }
    </div>

    <div class="links">
      <a href={SITE.resume} target="_blank" rel="noopener">Resume ↗</a>
      <a href={LINKS.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </div>
  </section>
</Base>
