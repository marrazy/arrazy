---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";
---

<Base title="Projects">
  <h1 class="title">Projects</h1>
  <div class="rows">
    {
      projects.map((p, i) => (
        <details class="row" open={i === 0}>
          <summary>
            {p.mark === "dot" ? <span class="dot" /> : <span class="mark">{p.mark}</span>}
            <span class="row-title">{p.title}</span>
            <span class="plus" aria-hidden="true">+</span>
          </summary>
          <div class="row-inner">
            {p.image && (
              <a class="shot" href={p.image.href ?? p.image.src.src} target="_blank" rel="noopener">
                <Image
                  src={p.image.src}
                  alt={p.image.alt}
                  widths={[780, 1560]}
                  sizes="(max-width: 820px) 100vw, 780px"
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </a>
            )}
            {p.body.map((text) => <p>{text}</p>)}
            {p.meta && <p class="meta">{p.meta}</p>}
            {p.links && (
              <p class="row-links">
                {p.links.map((l) => (
                  <a class="link" href={l.href} target="_blank" rel="noopener">{l.text} ↗</a>
                ))}
              </p>
            )}
          </div>
        </details>
      ))
    }
  </div>
</Base>
