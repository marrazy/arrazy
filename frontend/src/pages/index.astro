---
import Base from "../layouts/Base.astro";
import MusicLine from "../components/MusicLine";
import LocalTime from "../components/LocalTime.astro";
import { LINKS, SITE } from "../config";
---

<Base>
  <section class="home">
    <p class="hello">
      hi, my name is
      <span class="avatar"><img src={SITE.avatar} alt="" onerror="this.remove()" />A</span>
      {SITE.name}.
    </p>
    <p>
      currently studying Information Technology (Honours) @ <a class="u" href={LINKS.uts} target="_blank" rel="noopener">UTS</a>,
      and working in the data science, machine learning, and data visualisation and engineering fields.
    </p>
    <MusicLine client:load />
    <p>
      i tend to do a lot in life, and some of those thoughts turn into <a class="u" href="/projects/">projects</a>,
      <a class="u" href="/writings/">writings</a>, or snippets of <a class="u" href="/life/">photographs</a>. <LocalTime />
    </p>
    <p>
      if you are interested in my career, check my <a class="u" href={LINKS.github} target="_blank" rel="noopener">GitHub</a>
      or <a class="u" href="/work/">professional Work</a>.
    </p>
    <a class="out u" href={LINKS.github} target="_blank" rel="noopener">GitHub ↗</a>
  </section>
</Base>
